{
  "manifest_version": 3,
  "name": "Freelancer Job Radar",
  "version": "1.0",
  "description": "Automatically scans Freelancer.com for fresh projects, filters by budget, and auto-fills bids.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.freelancer.com/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.freelancer.com/search/projects*",
        "https://www.freelancer.com/job-search/projects*",
        "https://www.freelancer.com/jobs/php/*",
        "https://www.freelancer.com/jobs/website-design/*",
        "https://www.freelancer.com/jobs/*"
      ],
      "js": ["content/search_scraper.js"]
    },
    {
      "matches": [
        "https://www.freelancer.com/projects/*"
      ],
      "js": ["content/bid_agent.js"]
    }
  ]
}
